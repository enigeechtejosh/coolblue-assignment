APP_NAME="Pet API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:18780
LOG_CHANNEL=stderr
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
DB_CONNECTION=sqlite
DB_DATABASE=/app/storage/app/pets.sqlite
PETS_IMAGE_DISK=minio
PETS_IMAGE_DIRECTORY=pet-images
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=pet-images
MINIO_ENDPOINT=http://minio:9000
